# CeenAiX patient app — environment template.
# Copy to `.env` (git-ignored). Expo inlines any EXPO_PUBLIC_* variable into
# the client bundle, so ONLY publishable values belong here. Never put the
# Supabase service_role / secret key in this file.
#
# Values: Supabase Dashboard -> Project Settings -> API
#   dev  ref = lgfaucsfiyxvmsghnpey
#   prod ref = ziykaxyadcdmyakzvjff

EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>

# Optional: web portal origin used for "Open on web" links (defaults to https://www.ceenaix.com).
EXPO_PUBLIC_WEB_URL=https://dev.ceenaix.com

# Optional: EAS project id; enables Expo push token registration (`eas init` prints it).
EXPO_PUBLIC_EAS_PROJECT_ID=
