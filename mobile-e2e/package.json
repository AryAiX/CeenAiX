{
  "name": "ceenaix-mobile-e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:app": "cd ../mobile && npx expo export --platform web",
    "serve": "node serve.mjs",
    "test": "playwright test",
    "test:iphone": "playwright test --project=iphone-14",
    "test:pixel": "playwright test --project=pixel-7",
    "test:rtl": "playwright test --project=rtl-ar",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
